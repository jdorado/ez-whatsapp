{
  "name": "@jc_stack/ez-whatsapp",
  "version": "0.1.0-beta.2",
  "description": "Registered WhatsApp CLI plugin for agents, powered by Baileys",
  "type": "module",
  "license": "GPL-3.0-only",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "ez-whatsapp": "bin/ez-whatsapp.mjs"
  },
  "files": [
    "bin",
    "src",
    "skills",
    "docs",
    "ez-plugin.json",
    "README.md",
    "SECURITY.md",
    "LICENSE",
    "Dockerfile",
    "docker",
    "ez-deployment.json",
    "test",
    "CHANGELOG.md",
    "THIRD_PARTY_NOTICES.md",
    "CONTRIBUTING.md",
    "scripts/release-check.mjs",
    ".dockerignore",
    "LICENSE-MIT"
  ],
  "scripts": {
    "test": "node --test",
    "verify": "node --test && node --check src/cli.mjs",
    "prepublishOnly": "npm run verify",
    "smoke:docker": "node docker/smoke.mjs",
    "release:check": "node scripts/release-check.mjs"
  },
  "dependencies": {
    "@whiskeysockets/baileys": "7.0.0-rc14",
    "pino": "9.14.0",
    "qrcode": "1.5.4"
  },
  "packageManager": "pnpm@10.30.3",
  "publishConfig": {
    "access": "public",
    "tag": "beta",
    "registry": "https://registry.npmjs.org/"
  },
  "keywords": [
    "ai-agent",
    "cli",
    "docker",
    "whatsapp",
    "ez-plugin"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jdorado/ez-whatsapp.git"
  },
  "homepage": "https://github.com/jdorado/ez-whatsapp#readme",
  "bugs": {
    "url": "https://github.com/jdorado/ez-whatsapp/issues"
  }
}
